<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_account_journal_form" model="ir.ui.view">
        <field name="name">account.journal.form</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='advanced_settings']/group" position="inside">
                <group
                    name="cancel_option"
                    string="Cancel Option"
                    groups="base.group_no_one"
                >
                    <field name="cancel_method" widget="radio" />
                    <field
                        name="use_different_journal"
                        invisible="cancel_method != 'reversal'"
                    />
                    <field
                        name="reversal_journal_id"
                        widget="selection"
                        invisible="cancel_method != 'reversal' or not use_different_journal"
                        required="use_different_journal"
                    />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
